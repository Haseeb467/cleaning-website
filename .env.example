# Copy to .env and fill in the values you need. Everything is optional for
# local development: the app boots without them and simply skips the features
# that depend on them (login, maps, persistence).

# Server
PORT=3000

# MySQL connection string. Without it the app runs in "no database" mode.
DATABASE_URL=mysql://user:password@localhost:3306/cleanslate

# Manus platform (only needed when deploying to / running inside Manus)
MANUS_PROJECT_ID=
MANUS_OAUTH_API_URL=
MANUS_OAUTH_PORTAL_URL=
MANUS_JWT_SECRET=
MANUS_API_URL=
MANUS_API_KEY=
MANUS_API_BROWSER_KEY=
OWNER_OPEN_ID=
